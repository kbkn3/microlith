{
  "name": "microlith",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/blade",
    "smoke": "node packages/core/test/smoke.mjs",
    "build:blade": "npm run build --workspace @microlith/blade",
    "test:blade": "esbuild packages/blade/test/sync.test.mjs --bundle --platform=node --format=esm --outfile=packages/blade/test/.build.mjs --log-level=warning && node packages/blade/test/.build.mjs",
    "test:mcp": "node packages/core/test/mcp.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260825.1",
    "typescript": "^5.9.2",
    "wrangler": "4.125.0"
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_SECRET": {
        "description": "Protects the `/setup` page. Generate one with `openssl rand -hex 32`."
      }
    }
  }
}
