{
  "name": "microlith",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "secretlint": "secretlint \"**/*\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/blade",
    "check:static": "npm run secretlint && npm run format:check && npm run lint && npm run typecheck",
    "check": "npm run check:static && npm test",
    "prepare": "git config core.hooksPath .githooks",
    "test": "npm run test:registry",
    "smoke": "vp test packages/core/test/smoke.test.mjs",
    "build:blade": "npm run build --workspace @microlith/blade",
    "test:blade": "vp test packages/blade/test/sync.test.mjs",
    "test:mcp": "vp test packages/core/test/mcp.test.mjs",
    "test:oauth": "vp test packages/core/test/oauth.test.mjs",
    "test:registry": "vp test packages/core/test/registry.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260825.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "secretlint": "13.0.5",
    "typescript": "^7.0.2",
    "vite-plus": "0.3.0",
    "wrangler": "4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260820.1": true
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_SECRET": {
        "description": "Protects the `/setup` page. Generate one with `openssl rand -hex 32`."
      }
    }
  }
}
